# PostgreSQL connection string for local or Neon PostgreSQL. Never expose this to client code.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/CAREEROS?sslmode=require"

# Set to true only when running behind HTTPS in production.
COOKIE_SECURE="false"

# Owner account is created through `npm run owner:create`; do not store credentials here.

# Optional GitHub Releases URLs for desktop installers.
# Set these to the corresponding GitHub Releases asset URLs after publishing.
WINDOWS_DESKTOP_DOWNLOAD_URL=""
MACOS_DESKTOP_DOWNLOAD_URL=""
LINUX_DESKTOP_DOWNLOAD_URL=""
